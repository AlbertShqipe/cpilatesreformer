<section class="hero">
  <picture>
    <!-- Mobile image: shown when max-width is 768px -->
    <source media="(max-width: 768px)" srcset="https://manager.samadhi-lyon.fr/storage/01JAJ0NPFJZM7HE1JCVM3XM0NQ.png">

    <!-- Default (desktop) image -->
    <%= image_tag "chiara.jpeg",
          alt: "Pilates en mouvement",
          class: "hero__bg",
          loading: "eager",
          fetchpriority: "high" %>
  </picture>
  <div class="hero__overlay">
    <div class="hero__text">
      <h1 class="hero__title">Équilibre. Mouvement. Bien-être.</h1>
      <p class="hero__subtitle">Une méthode douce et précise pour retrouver équilibre, posture et énergie</p>
    </div>
    <a href="https://www.eversports.fr/org/widget/overview?companyId=659faeaa-0fe1-4fdc-bc8e-caa5a74a57e5" class="hero__btn">Réserver un cours</a>
  </div>
</section>
